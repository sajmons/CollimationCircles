<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!--Avalonia doesen't support TrimMode=link currently,but we are working on that https://github.com/AvaloniaUI/Avalonia/issues/6892 -->
    <TrimMode>copyused</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <LangVersion>latest</LangVersion>
    <StartupObject>CollimationCircles.Program</StartupObject>
    <PackageProjectUrl>https://github.com/sajmons/CollimationCircles</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sajmons/CollimationCircles</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>5.0.0-beta1</Version>
    <InformationalVersion>5.0.0-beta1</InformationalVersion>
    <Authors>Simon Šander</Authors>
    <Product>Collimation Circles</Product>
    <Copyright>Copyright © 2023</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <CFBundleShortVersionString>$(Version)</CFBundleShortVersionString>
    <ApplicationIcon>Resources\Images\icon_256px.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Label="Avalonia">
    <AvaloniaXamlReportImportance>Normal</AvaloniaXamlReportImportance>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\**" />
  </ItemGroup>
  <ItemGroup>
    <!--This helps with theme dll-s trimming. If you will publish your application in self-contained mode with p:PublishTrimmed=true and it will use Fluent theme Default theme will be trimmed from the output and vice versa. https://github.com/AvaloniaUI/Avalonia/issues/5593 -->
    <TrimmableAssembly Include="Avalonia.Themes.Fluent" />
    <TrimmableAssembly Include="Avalonia.Themes.Default" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ASCOM.Alpaca.Components" Version="4.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4">
      <TreatAsUsed>true</TreatAsUsed>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DeviceId.Linux" Version="6.11.0" />
    <PackageReference Include="DeviceId.Mac" Version="6.11.0" />
    <PackageReference Include="DeviceId.Windows.WmiLight" Version="6.11.0" />
    <PackageReference Include="HanumanInstitute.MvvmDialogs.Avalonia.MessageBox" Version="2.4.0" />
    
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Magick.NET.SystemDrawing" Version="8.0.28" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.2.1" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="Standard.Licensing" Version="1.3.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />    
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />    
  </ItemGroup>

  <!-- Cross-platform packages -->

  <!-- Windows platform packages (win-x64, win-arm64) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or '$(RuntimeIdentifier)' == ''">
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' != 'win-arm64'" />
    <PackageReference Include="OpenCvSharp4.runtime.win-arm64" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" />
  </ItemGroup>

  <!-- Linux platform packages (linux-x64, linux-arm64) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />
    <PackageReference Include="OpenCvSharp4.runtime.linux-arm64" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' == 'linux-arm64'" />
  </ItemGroup>

  <!-- macOS platform packages (osx-x64, osx-arm64) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64'">
    <PackageReference Include="OpenCvSharp4.runtime.osx.x64" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' == 'osx-x64'" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'" />
  </ItemGroup>  

  <ItemGroup>
    <ProjectReference Include="..\CollimationCirclesFeatures\CollimationCirclesFeatures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaXaml Update="Controls\CollimationAnalysisUserControl.axaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\AlpacaServerUserControl.axaml.cs">
      <DependentUpon>AlpacaServerUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\LicenseUserControl.axaml.cs">
      <DependentUpon>LicenseUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\ProfileManagerUserControl.axaml.cs">
      <DependentUpon>ProfileManagerUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\AboutUserControl.axaml.cs">
      <DependentUpon>AboutUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\CollimationAnalysisUserControl.axaml.cs">
      <SubType>Code</SubType>
      <DependentUpon>CollimationAnalysisUserControl.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\RequestLicenseView.axaml.cs">
      <DependentUpon>RequestLicenseView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\ImageView.axaml.cs">
      <DependentUpon>ImageView.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="icon.icns">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="license1.lic">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="trial license.lic">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
