<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="250"
             x:Class="CollimationCircles.Controls.AlpacaFocuserUserControl"
             xmlns:vm="using:CollimationCircles.ViewModels"
             x:DataType="vm:StreamViewModel">
    <GroupBox
        IsVisible="{Binding IsAlpacaCameraSelected}"
        Header="{DynamicResource Text.FocuserControls}">
        <StackPanel Spacing="{DynamicResource ControlSpacing}">
            <DockPanel LastChildFill="True">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Text="{DynamicResource Text.FocuserDevice}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding IsServerConnected}"
                    ItemsSource="{Binding Focusers}"
                    SelectedItem="{Binding SelectedFocuser}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                <Button
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{DynamicResource Text.FocuserIn}"
                    Command="{Binding MoveFocuserInCommand}"
                    IsEnabled="{Binding CanMoveFocuser}" />
                <Button
                    Grid.Column="1"
                    Content="{DynamicResource Text.FocuserHalt}"
                    Command="{Binding HaltFocuserCommand}"
                    IsEnabled="{Binding IsFocuserMoving}" />
                <Button
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Content="{DynamicResource Text.FocuserOut}"
                    Command="{Binding MoveFocuserOutCommand}"
                    IsEnabled="{Binding CanMoveFocuser}" />
            </Grid>

            <DockPanel LastChildFill="True">
                <TextBlock
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Text="{DynamicResource Text.FocuserStep}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    IsEnabled="{Binding CanControlFocuser}"
                    ItemsSource="{Binding FocuserSteps}"
                    SelectedItem="{Binding SelectedFocuserStep}" />
            </DockPanel>

            <CheckBox
                Content="{DynamicResource Text.FocuserInvertDirection}"
                IsEnabled="{Binding CanControlFocuser}"
                IsChecked="{Binding InvertFocuserDirection}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource Text.FocuserPosition}" />
                <TextBlock Text="{Binding FocuserPositionText}" />
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
