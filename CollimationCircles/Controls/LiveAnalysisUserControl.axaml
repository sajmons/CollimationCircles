<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
			 x:Class="CollimationCircles.Controls.LiveAnalysisUserControl"
			 xmlns:vm="using:CollimationCircles.ViewModels"
			 x:DataType="vm:CollimationAnalysisViewModel">

	<StackPanel Orientation="Vertical" Spacing="{DynamicResource ControlSpacing}">

		<Grid 
			ColumnSpacing="{DynamicResource ControlSpacing}"
			ColumnDefinitions="Auto,*">
			<Button
				DockPanel.Dock="Right"
				Theme="{DynamicResource ToolbarButton}"
				Command="{Binding LoadImageCommand}"
				ToolTip.Tip="{DynamicResource Text.LoadImage}">
				<PathIcon
					Width="{DynamicResource PathIconWidth}"
					Height="{DynamicResource PathIconHeight}"
					Foreground="{DynamicResource Color2}"
					Data="{StaticResource IconData.Image}" />
			</Button>
			<TextBlock
				Grid.Column="1"
				IsVisible="{Binding !IsStreaming}"
				Text="{DynamicResource Text.LiveAnalysisTip}"
				VerticalAlignment="Top"
				TextWrapping="Wrap"/>
		</Grid>

		<Grid
			ColumnSpacing="{DynamicResource ControlSpacing}"
			RowSpacing="{DynamicResource ControlSpacing}"
			ColumnDefinitions="*,Auto"
			RowDefinitions="Auto,Auto">

			<TextBlock
				Text="{DynamicResource Text.DefocusedStarAnalysis}"
				VerticalAlignment="Center"/>
			<ToggleSwitch
				Grid.Column="1"
				IsChecked="{Binding IsLiveAnalysisActive}"
				IsEnabled="{Binding IsStreaming}"
				ToolTip.Tip="{DynamicResource Text.TipDefocusedStarAnalysis}"
				OnContent="" OffContent="">
			</ToggleSwitch>

			<TextBlock
				Grid.Row="1"
				Text="{DynamicResource Text.OpticalTubeAnalysis}"
				VerticalAlignment="Center"/>
			<ToggleSwitch
				Grid.Row="1"
				Grid.Column="1"
				IsChecked="{Binding IsLiveRmseActive}"
				IsEnabled="{Binding IsStreaming}"
				HorizontalAlignment="Stretch"
				ToolTip.Tip="{DynamicResource Text.TipOpticalTubeAnalysis}"
				OnContent="" OffContent="">
			</ToggleSwitch>
		</Grid>
	</StackPanel>
</UserControl>
