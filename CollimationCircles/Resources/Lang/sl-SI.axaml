    <system:String x:Key="Text.AnalysisRmsePercent">RMSE: {0:F1}% polmera</system:String>
    <system:String x:Key="Text.AnalysisNotEnoughCircles">Zaznanih je premalo krogov ({0} od 2 potrebnih). Prilagodite osvetlitev/občutljivost ali položaj kamere.</system:String>
